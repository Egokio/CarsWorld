<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="Cars.WpfApp.MainWindow"
        Title="Cars World"
        Height="584"
        Width="878">

    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0*"/>
            <ColumnDefinition Width="395*"/>
            <ColumnDefinition Width="453*"/>
        </Grid.ColumnDefinitions>
        <TabControl SelectionChanged="TabControl_SelectionChanged_1" Grid.ColumnSpan="3">
            
            <TabItem Header="Cars">
                <Grid Background="#FFF3F5F8" Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="228"/>
                        <RowDefinition Height="48"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="SearchBox"
             Grid.Column="0"
             Margin="4,3,8,5"
             Padding="8,4"
             FontSize="14"
             ToolTip="Search by name or model"
             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>



                            <Button Grid.Column="2"
            Content="Group by Type"
            Margin="4,3,4,5"
            Padding="12,4"
            Command="{Binding GroupByTypeCommand}"/>
                        </Grid>

                        <Button Grid.Column="1"
            Content="Sort by Speed"
            Margin="4,3,4,5"
            Padding="12,4"
            Command="{Binding SortBySpeedCommand}"/>
                    </Grid>

                    <!-- Cars table -->
                    <DataGrid x:Name="CarsGrid"
                  Grid.Row="1"
                  Margin="4"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionChanged="CarsGrid_SelectionChanged"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="30"
                  ColumnHeaderHeight="34">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name"
                                    Binding="{Binding Name}"
                                    Width="2*"/>
                            <DataGridTextColumn Header="Model"
                                    Binding="{Binding Model}"
                                    Width="2*"/>
                            <DataGridTextColumn Header="Speed"
                                    Binding="{Binding Speed}"
                                    Width="*"/>
                            <DataGridTextColumn Header="Fuel"
                                    Binding="{Binding Fuel}"
                                    Width="*"/>
                            <DataGridTextColumn Header="Condition"
                                    Binding="{Binding Condition}"
                                    Width="1.3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    
                    <ListBox x:Name="CarsGroupsList"
         Grid.Row="1"
         Margin="4"
         ItemsSource="{Binding CarsByType}"
         Visibility="Collapsed">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <GroupBox Header="{Binding Key}" Margin="4">
                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="6,3"
                                       Text="{Binding Name}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    
                    <!-- New car form -->
                    <Border Grid.Row="2"
                Margin="4"
                Padding="8"
                Background="White"
                BorderBrush="#FFD7DEE8"
                BorderThickness="1"
                CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Name -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                                <Label Content="Name" FontWeight="Bold" Padding="0,0,0,2"/>
                                <TextBox x:Name="NameBox"
                             Height="28"
                             Padding="5,3"
                             Text="{Binding NewCarName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Model -->
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                                <Label Content="Model" FontWeight="Bold" Padding="0,0,0,2"/>
                                <TextBox x:Name="ModelBox"
                             Height="28"
                             Padding="5,3"
                             Text="{Binding NewCarModel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Car type -->
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                                <Label Content="Car type" FontWeight="Bold" Padding="0,0,0,2"/>
                                <ComboBox x:Name="CarTypeBox"
                              Height="28"
                              SelectionChanged="CarTypeBox_SelectionChanged"/>
                            </StackPanel>

                            <!-- Speed -->
                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                                <Label Content="Speed" FontWeight="Bold" Padding="0,0,0,2"/>
                                <TextBox x:Name="SpeedBox"
                             Height="28"
                             Padding="5,3"
                             Text="{Binding NewCarSpeed, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Fuel -->
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                                <Label Content="Fuel" FontWeight="Bold" Padding="0,0,0,2"/>
                                <TextBox x:Name="FuelBox"
                             Height="28"
                             Padding="5,3"
                             Text="{Binding NewCarFuel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Condition -->
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="4">
                                <Label Content="Condition" FontWeight="Bold" Padding="0,0,0,2"/>
                                <TextBox x:Name="ConditionBox"
                             Height="28"
                             Padding="5,3"
                             Text="{Binding NewCarCondition, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Turbo level -->
                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="4">
                                <Label Content="Turbo level" FontWeight="Bold" Padding="0,0,0,2"/>
                                <TextBox x:Name="TurboLevelBox"
                             Height="28"
                             Padding="5,3"
                             Text="{Binding NewTurboLevel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Tow capacity -->
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="4">
                                <Label Content="Tow capacity" FontWeight="Bold" Padding="0,0,0,2"/>
                                <TextBox x:Name="TowCapacityBox"
                             Height="28"
                             Padding="5,3"
                             Text="{Binding NewTowCapacity, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Siren -->
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="4">
                                <Label Content="Siren on" FontWeight="Bold" Padding="0,0,0,2"/>
                                <ComboBox x:Name="SirenOnBox"
                              Height="28"
                              SelectedValue="{Binding NewSirenOn, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Water level (Fire Truck) -->
                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="4">
                                <Label Content="Water level" FontWeight="Bold" Padding="0,0,0,2"/>
                                <TextBox x:Name="WaterLevelBox"
                             Height="28"
                             Padding="5,3"
                             Text="{Binding NewWaterLevel, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>

                            <!-- Fare per km (Taxi) -->
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="4">
                                <Label Content="Fare per km" FontWeight="Bold" Padding="0,0,0,2"/>
                                <TextBox x:Name="FarePerKmBox"
                             Height="28"
                             Padding="5,3"
                             Text="{Binding NewFarePerKm, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Action buttons -->
                    <Grid Grid.Row="3" Margin="4,3,4,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="AddCarButton"
                    Grid.Column="0"
                    Content="＋  Add Car"
                    Command="{Binding AddCarCommand}"
                    Margin="0,0,4,0"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#FF2463A6"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>

                        <Button x:Name="RemoveCarButton"
                    Grid.Column="1"
                    Content="✕  Remove Car"
                    Command="{Binding RemoveCarCommand}"
                    Margin="4,0,0,0"
                    FontSize="14"
                    FontWeight="Bold"
                    Background="#FFB93C45"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
                    </Grid>
                </Grid>

            </TabItem>
            <TabItem Header="Selected Car" Margin="1,-2,-4,0">
                <Grid Background="#FFE5E5E5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="124*"/>
                        <ColumnDefinition Width="8*"/>
                        <ColumnDefinition Width="13*"/>
                        <ColumnDefinition Width="697*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.ColumnSpan="4">
                        <TextBlock TextWrapping="Wrap" FontSize="20" FontWeight="Bold" Text="Selected Car"/>
                        <TextBlock x:Name="SelectedNameLabel" TextWrapping="Wrap" FontWeight="Bold" Text="Name:"/>
                        <TextBlock x:Name="SelectedNameValue" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedModelLabel" TextWrapping="Wrap" FontWeight="Bold" Text="Model:"/>
                        <TextBlock x:Name="SelectedModelValue" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedSpeedLabel" TextWrapping="Wrap" FontWeight="Bold" Text="Speed:"/>
                        <TextBlock x:Name="SelectedSpeedValue" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedFuelLabel" TextWrapping="Wrap" FontWeight="Bold" Text="Fuel:"/>
                        <TextBlock x:Name="SelectedFuelValue" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedConditionLabel" TextWrapping="Wrap" Text="Condition:" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedConditionValue" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedTurboLabel" TextWrapping="Wrap" Text="Turbo Level:" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedTurboValue" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedTowCapacityLabel" TextWrapping="Wrap" Text="Tow Capacity:" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedTowCapacityValue" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SelectedSirenLabel" TextWrapping="Wrap" Text="Siren On:" FontWeight="Bold"/>
                        <TextBlock x:Name="SelectedSirenValue" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="120,0,0,0">
                        <TextBlock TextWrapping="Wrap" FontSize="20" FontWeight="Bold" Text="Type Details"/>
                        <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="Patients Transported:"/>
                        <TextBlock x:Name="SelectedPatientsValue" TextWrapping="Wrap"/>
                        <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="Water Level:"/>
                        <TextBlock x:Name="SelectedWaterLevelValue" TextWrapping="Wrap"/>
                        <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="Fare:"/>
                        <TextBlock x:Name="SelectedFareValue" TextWrapping="Wrap"/>
                        <TextBlock TextWrapping="Wrap" FontWeight="Bold" Text="Taxi Rides:"/>
                        <TextBlock x:Name="SelectedRidesValue" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="CrazyActionButton" Content="Crazy Action!" HorizontalAlignment="Left" Margin="10,292,0,0" VerticalAlignment="Top" Width="178" Click="Button_Click_2" Height="34" FontSize="16" FontWeight="Bold" Grid.ColumnSpan="4"/>
                    <Button x:Name="RepairButton" Content="Repair" HorizontalAlignment="Left" Margin="10,393,0,0" VerticalAlignment="Top" Height="28" Width="178" FontWeight="Bold" Click="RepairButton_Click" Grid.ColumnSpan="4"/>
                    <Button x:Name="RefuelButton" Content="Refuel" HorizontalAlignment="Left" Margin="10,360,0,0" VerticalAlignment="Top" Height="27" Width="178" FontWeight="Bold" Click="RefuelButton_Click" Grid.ColumnSpan="4"/>
                    <TextBox x:Name="ActionAmountBox" HorizontalAlignment="Center" Margin="0,332,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Grid.Column="1"/>
                    <TextBlock HorizontalAlignment="Left" Margin="10,331,0,0" TextWrapping="Wrap" Text="Amount" VerticalAlignment="Top" FontSize="14" FontWeight="Bold"/>
<Button x:Name="DriveButton"
        Content="Drive"
        HorizontalAlignment="Left"
        Margin="10,426,0,0"
        VerticalAlignment="Top"
        Click="Button_Click_1"
        Height="30"
        Width="178"
        FontWeight="Bold"
        Grid.ColumnSpan="4"/>
                </Grid>
            </TabItem>
            <TabItem Header="Log" Margin="4,-2,-9,0">
                <Grid Background="#FFE5E5E5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Action Log"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="10"
                   VerticalAlignment="Center"/>

                    <TextBox x:Name="LogTextBox"
                             Grid.Row="1"
                             Margin="10"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Text="{Binding LogText, Mode=OneWay}"/>            
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>

</Window>
